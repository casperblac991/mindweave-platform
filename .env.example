# Public runtime and Supabase
PORT=10000
SUPABASE_URL=https://mtirzcuntupkuavmjtcv.supabase.co
SUPABASE_ANON_KEY=replace_with_public_anon_key
# لوحة العمليات تتحقق من جلسة المالك وتستخدم سياسات RLS المقيدة؛ لا يلزم مفتاح خدمة واسع الصلاحيات.

# AI provider. The current validated Render provider is NVIDIA's OpenAI-compatible endpoint.
OPENAI_API_KEY=replace_with_nvidia_api_key
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.1-8b-instruct
AI_MAX_TOKENS=650
AI_RATE_LIMIT=20
AI_RATE_WINDOW_MS=600000
# NVIDIA is configured without JSON Schema output. Set true only for a provider that supports it.
AI_STRUCTURED_OUTPUT=false

# Content operations are disabled by default. They produce review-only drafts, never automatic public posts.
AI_CONTENT_CYCLE_ENABLED=false
AI_MAX_SOURCES_PER_RUN=8
AI_MAX_ITEMS_PER_SOURCE=6

# Optional external health check target, e.g. https://mindweave.store
HEALTHCHECK_URL=https://mindweave.store
